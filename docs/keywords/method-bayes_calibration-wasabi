             "bayes_calibration": {
               "sub_method": {
                 "wasabi": {
                   "pushforward_samples": 100,
                   "data_distribution": {
                     "gaussian": {
                       "means": [0.0],
                       "covariance": {
                         "values": [1.0],
                         "type": {
                           "diagonal": true
