Blurb::
Generating matrices that provide up to 2\ :sup:`32` points in up to 1024 dimensions

Description::
See :cite:p:`QMCPy`.

Topics::

Examples::

.. tab:: Freeform

   .. code-block:: dakota

       environment
         tabular_data
           tabular_data_file = 'samples.dat'
           freeform

       method
         sampling
           samples 1024
           sample_type
             low_discrepancy
               digital_net
                 generating_matrices predefined sobol_order_2

       variables
         uniform_uncertain = 2
           lower_bounds 0.0 0.0
           upper_bounds 1.0 1.0

       interface
         analysis_drivers = 'genz'
         analysis_components = 'cp1'
         direct

       responses
         response_functions = 1
         no_gradients
         no_hessians

.. tab:: JSON

   .. code-block:: json

       {
         "environment": {
           "tabular_data": {
             "tabular_data_file": "samples.dat",
             "format": {
               "freeform": true
             }
           }
         },
         "method": [
           {
             "sampling": {
               "samples": 1024,
               "sample_type": {
                 "low_discrepancy": {
                   "digital_net": {
                     "generating_matrices": {
                       "predefined": {
                         "sobol_order_2": true
                       }
                     }
                   }
                 }
               }
             }
           }
         ],
         "variables": [
           {
             "uniform_uncertain": {
               "lower_bounds": [
                 0.0,
                 0.0
               ],
               "upper_bounds": [
                 1.0,
                 1.0
               ],
               "count": 2
             }
           }
         ],
         "interface": [
           {
             "analysis_drivers": {
               "drivers": [
                 "genz"
               ],
               "analysis_components": [
                 "cp1"
               ],
               "interface_type": {
                 "direct": {}
               }
             }
           }
         ],
         "responses": [
           {
             "response_type": {
               "response_functions": {
                 "count": 1
               }
             },
             "gradient_type": {
               "no_gradients": true
             },
             "hessian_type": {
               "no_hessians": true
             }
           }
         ]
       }
