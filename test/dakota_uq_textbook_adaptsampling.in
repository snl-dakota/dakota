# DAKOTA INPUT FILE - dakota_uq_textbook_adaptsampling.in
# Adaptive sampling tests varying fitness_metric, batch_selection, and
# synchronous vs. asynchronous interface.
#   s0: predicted_variance fitness, naive batch, direct (sync) - baseline
#   s1: distance fitness, naive batch, direct
#   s2: gradient fitness, naive batch, direct
#   s3: predicted_variance fitness, distance batch, direct
#   s4: distance fitness, distance batch, direct
#   s5: predicted_variance fitness, naive batch, fork async
#   s6: distance fitness, naive batch, fork async
#   s7: gradient fitness, naive batch, fork async

method,
	adaptive_sampling
	  initial_samples = 20
	  seed = 1234
	  response_levels = 10.0
	  samples_on_emulator = 400
	  max_iterations = 50
	  refinement_samples = 2
	  batch_selection = naive                 #s0,#s1,#s2,#s5,#s6,#s7
#	  batch_selection = distance              #s3,#s4
	  fitness_metric = predicted_variance     #s0,#s3,#s5
#	  fitness_metric = distance               #s1,#s4,#s6
#	  fitness_metric = gradient               #s2,#s7

variables,
	uniform_uncertain = 2
	  descriptors  = 'x1' 'x2'
	  lower_bounds = -2.0 -2.0
	  upper_bounds =  2.0  2.0

interface,
	direct                                               #s0,#s1,#s2,#s3,#s4
#	fork                                                 #s5,#s6,#s7
	  analysis_driver = 'text_book'
#	  asynchronous evaluation_concurrency = 4            #s5,#s6,#s7

responses,
	response_functions = 1
	no_gradients
	no_hessians
