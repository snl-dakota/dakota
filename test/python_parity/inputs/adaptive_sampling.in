environment
  method_pointer 'main'
method
  id_method 'main'
  model_pointer 'target'
  adaptive_sampling
    initial_samples 8
    seed 1234
    max_iterations 1
    samples_on_emulator 16
    refinement_samples 1
model
  id_model 'target'
  simulation
variables
  uniform_uncertain 2
    lower_bounds -1.0 -1.0
    upper_bounds 1.0 1.0
responses
  response_functions 1
  no_gradients
  no_hessians
interface
  analysis_drivers 'python3 response_driver.py high' fork
