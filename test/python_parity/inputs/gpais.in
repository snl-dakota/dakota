environment
  method_pointer 'main'
method
  id_method 'main'
  model_pointer 'target'
  gpais
    build_samples 12
    seed 1234
    samples_on_emulator 32
    response_levels 0.5
    max_iterations 2
model
  id_model 'target'
  simulation
variables
  uniform_uncertain 2
    lower_bounds -1.0 -1.0
    upper_bounds 1.0 1.0
responses
  response_functions 1
  no_gradients
  no_hessians
interface
  analysis_drivers 'python3 response_driver.py high' fork
