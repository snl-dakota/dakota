method
  external_python
    class_path_and_name "ext_py_methods.SimplePyOpt"
    options_file 'ext_py_options.json'
variables
  continuous_design 2
    initial_point 0.5 0.5
    lower_bounds -2.0 -2.0
    upper_bounds  2.0  2.0
    descriptors 'x1' 'x2'
interface
  analysis_drivers 'text_book' fork
responses
  objective_functions 1
  no_gradients
  no_hessians
