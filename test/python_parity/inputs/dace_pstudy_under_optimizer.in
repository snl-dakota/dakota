environment
  method_pointer 'outer'
method
  id_method 'outer'
  model_pointer 'surr'
  optpp_pds
    max_iterations 5
    max_function_evaluations 25
model
  id_model 'surr'
  global_surrogate polynomial quadratic
    truth_model_pointer 'truth'
    dace_method_pointer 'dace'
method
  id_method 'dace'
  model_pointer 'truth'
  sampling
    samples 16 seed 1234 sample_type lhs
model
  id_model 'truth'
  simulation
variables
  continuous_design 2
    initial_point 1.0 1.0
    lower_bounds 0.5 0.5
    upper_bounds 1.5 1.5
    descriptors 'x1' 'x2'
  uniform_uncertain 1
    lower_bounds 0.5
    upper_bounds 1.5
responses
  objective_functions 1
  no_gradients
  no_hessians
interface
  analysis_drivers 'text_book' fork
