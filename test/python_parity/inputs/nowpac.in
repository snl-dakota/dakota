method
  nowpac
  max_iterations = 500
  trust_region
    initial_size = 0.10
    minimum_size = 1.e-6
    contract_threshold = 0.25
    expand_threshold   = 0.75
    contraction_factor = 0.50
    expansion_factor   = 1.50
variables
  continuous_design = 2
    initial_point   -1.2  1.0
    lower_bounds    -2.0 -2.0
    upper_bounds     2.0  2.0
    descriptors      'x1' 'x2'
interface
  direct
    analysis_driver = 'rosenbrock'
responses
  objective_functions = 1
  no_gradients
  no_hessians
