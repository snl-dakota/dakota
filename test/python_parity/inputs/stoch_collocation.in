environment
  method_pointer 'main'
method
  id_method 'main'
  model_pointer 'target'
  stoch_collocation
    quadrature_order 3
model
  id_model 'target'
  simulation
variables
  uniform_uncertain 2
    lower_bounds -1.0 -1.0
    upper_bounds 1.0 1.0
responses
  response_functions 1
  no_gradients
  no_hessians
interface
  analysis_drivers 'python3 response_driver.py high' fork
