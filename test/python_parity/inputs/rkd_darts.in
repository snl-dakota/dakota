environment
  method_pointer 'main'
method
  id_method 'main'
  model_pointer 'target'
  rkd_darts
    build_samples 12
    seed 1234
    samples_on_emulator 32
    response_levels 0.5
model
  id_model 'target'
  global_surrogate
    truth_model_pointer 'truth'
    dace_method_pointer 'dace'
    gaussian_process surfpack
method
  id_method 'dace'
  model_pointer 'truth'
  sampling
    samples 12
    seed 1234
    sample_type lhs
model
  id_model 'truth'
  simulation
variables
  uniform_uncertain 2
    lower_bounds -1.0 -1.0
    upper_bounds 1.0 1.0
responses
  response_functions 1
  no_gradients
  no_hessians
interface
  analysis_drivers 'python3 response_driver.py high' fork
