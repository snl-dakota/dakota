#@ *: DakotaConfig=HAVE_NOWPAC

method
  nowpac
  max_iterations = 500
# convergence_tolerance = 1e-4
  trust_region
    initial_size = 0.10
    minimum_size = 1.e-6
    contract_threshold = 0.25
    expand_threshold   = 0.75
    contraction_factor = 0.50
    expansion_factor   = 1.50

variables
  continuous_design = 2
    initial_point   -1.2  1.0				#s0,
    lower_bounds    -2.0 -2.0				#s0,
    upper_bounds     2.0  2.0				#s0,
    descriptors      'x1' 'x2'		  		#s0,#s2,#s3
#   initial_point    4.0          4.0			#s1
#   upper_bounds    10.0         10.0			#s1
#   lower_bounds     1.0          1.0			#s1
#   descriptors     'w' 't'				#s1
# continuous_state = 4					#s1
#   initial_state   40000.  29.E+6  500.  1000.		#s1
#   descriptors       'R'    'E'    'X'    'Y'		#s1
# Feasible starting point (Barnes)
#	  initial_point    30.   40.			#s2
# Infeasible starting point (Barnes)
#	  initial_point    10.   20.			#s3
#	  lower_bounds      0.    0.			#s2,#s3
#	  upper_bounds     80.   80.			#s2,#s3

interface
  direct
    analysis_driver = 'rosenbrock'			#s0
#   analysis_driver = 'cantilever'			#s1
#   analysis_driver = 'barnes'				#s2,#s3

responses
  objective_functions = 1
# nonlinear_inequality_constraints = 2				#s1
# nonlinear_inequality_constraints = 3				#s2,#s3
#  nonlinear_inequality_lower_bounds = 0.     0.     0.		#s2,#s3
#  nonlinear_inequality_upper_bounds = 1.e+50 1.e+50 1.e+50	#s2,#s3
  no_gradients
  no_hessians
