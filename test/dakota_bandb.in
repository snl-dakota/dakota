#@ s*: Label=FastTest
#@ s1: DakotaConfig=HAVE_NPSOL
#@ s2: DakotaConfig=HAVE_ACRO
# s3: test correct traits coverage
# s4: method_name form for branch_and_bound

environment
  method_pointer = 'BandB'

method
  id_method = 'BandB'
  branch_and_bound
    output verbose
    method_pointer = 'SubNLP'                    #s0,#s1,#s2,#s3
#    method_name 'conmin_frcg'                   #s4

method                                           #s0,#s1,#s2,#s3
  id_method = 'SubNLP'                           #s0,#s1,#s2,#s3
  conmin_frcg					#s0,#s3
#  npsol_sqp					#s1
#  soga 					#s2
#    seed = 123451337				#s2
    max_iterations = 1000                        #s0,#s1,#s2,#s3
    max_function_evaluations = 10000             #s0,#s1,#s2,#s3

variables,
	continuous_design = 3
	  initial_point   -1.0    1.5   2.0
	  upper_bounds    10.0   10.0  10.0
	  lower_bounds   -10.0  -10.0 -10.0
	  descriptors      'x1'  'x2'  'x3'
#	discrete_design_range = 2		#s2
#	  initial_point      2     2		#s2
#	  lower_bounds       1     1		#s2
#	  upper_bounds       4     9		#s2
#	  descriptors      'y1'   'y2'		#s2
	discrete_design_set			#s0,#s1,#s3,#s4
	  integer = 1				#s0,#s1,#s3,#s4
	    num_set_values = 4			#s0,#s1,#s3,#s4
	    set_values = 1 2 3 4		#s0,#s1,#s3,#s4
	    descriptors  'z1'			#s0,#s1,#s3,#s4
	  categorical 'no'			#s0,#s1,#s3,#s4

interface,
	direct
	  analysis_driver = 'text_book'

responses,
	objective_functions = 1
	nonlinear_inequality_constraints = 2	#s0,#s1,#s2,#s4
#	nonlinear_inequality_constraints = 1	#s3
#	nonlinear_equality_constraints = 1		#s3
	numerical_gradients
	no_hessians
